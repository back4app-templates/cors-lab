# Copy to .env if you need to override anything. Never commit .env. Phase A needs NO env vars at all:
# every default below points at the local lab map and `npm run dev` just works.
#
# API server (api/server.mjs)
PORT=1345
# Comma-separated CORS allowlist. Default: http://localhost:1346,https://localhost:1349
# (the dev origin http://localhost:5173 is deliberately NOT in the default — that is row R8).
ALLOWED_ORIGINS=
# The reflect-origin anti-pattern route ships OFF. Set to 1 only for the labeled counter-case capture,
# never in a default deploy (amendment-9 pattern).
UNSAFE_REFLECT_ORIGIN=

# Page server (page/server.mjs) — where the static page finds the other pieces (/config.js).
# Live phase: point these at the deployed Containers URLs instead of the local map.
API_ORIGIN=http://localhost:1345
API_CROSS_SITE=http://127.0.0.1:1345
CACHE_PROXY=http://localhost:1348
RELAY=http://127.0.0.1:1347
DEV_PORT=5173
HTTPS_PORT=1349

# Cache proxy (cache/proxy.mjs)
TARGET=http://localhost:1345
